{
  "$defs": {
    "Notification": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "type": {
          "default": "info",
          "enum": [
            "info",
            "success",
            "warning",
            "error"
          ],
          "title": "Type",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "message": {
          "maxLength": 40000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "priority": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "dismissible": {
          "default": false,
          "title": "Dismissible",
          "type": "boolean"
        },
        "schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/Schedule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "message"
      ],
      "title": "Notification",
      "type": "object"
    },
    "Schedule": {
      "additionalProperties": false,
      "description": "One continuous, inclusive window expressed in local dates and times.",
      "properties": {
        "startDate": {
          "format": "date",
          "title": "Startdate",
          "type": "string"
        },
        "endDate": {
          "format": "date",
          "title": "Enddate",
          "type": "string"
        },
        "startTime": {
          "format": "time",
          "title": "Starttime",
          "type": "string"
        },
        "endTime": {
          "format": "time",
          "title": "Endtime",
          "type": "string"
        },
        "timezone": {
          "default": "Australia/Sydney",
          "maxLength": 100,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "startDate",
        "endDate",
        "startTime",
        "endTime"
      ],
      "title": "Schedule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "notifications": {
      "items": {
        "$ref": "#/$defs/Notification"
      },
      "maxItems": 1000,
      "title": "Notifications",
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "notifications"
  ],
  "title": "NotificationDocument",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
